# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection for runtime (use with @neondatabase/serverless)
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations only
DIRECT_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Read-only connection to WRP property management tables.
# Uses the wrp_notebook_app PostgreSQL user (SELECT-only permissions).
# Run scripts/setup-readonly-role.sql in Neon SQL Editor first, then set this.
# Use the direct (non-pooler) Neon hostname for this one.
PROPERTY_DB_URL="postgresql://wrp_notebook_app:CHANGE_ME@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (NextAuth.js v5) ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Credential Encryption ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-64-char-hex-string"

# ─── AI Providers ────────────────────────────────────────────────────────────
# === Database Connection ===
# Point this to your Neon branch (e.g., 'local-llm-testing')
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require"

# === Local Inference Routing (llmster) ===
# Generation (Anthropic SDK format)
LLM_BASE_URL="http://llmster:1234"
ANTHROPIC_API_KEY="lm-studio"
LLM_MODEL="meta-llama-3.1-8b-instruct"

# Embeddings (OpenAI SDK format)
EMBEDDING_BASE_URL="http://llmster:1234/v1"
EMBEDDING_API_KEY="lm-studio"
EMBEDDING_MODEL="nomic-embed-text-v1.5"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
