# ─── Database ─────────────────────────────────────────────────────────────────
# Pick ONE of the two blocks below depending on how you're running the app.
# See README.md → "Local LLM Development (Docker)" for the full local setup.

# --- Option A: Neon PostgreSQL (cloud) ---
# Pooled connection for runtime (use with @neondatabase/serverless)
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations only — never read by the app at runtime
DIRECT_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Option B: local Docker Compose stack (postgres + wsproxy) ---
# LOCAL_POSTGRES=true
# DATABASE_URL="postgresql://postgres:postgres@wsproxy:5432/notebook?sslmode=disable"
# DIRECT_URL="postgresql://postgres:postgres@postgres:5432/notebook?sslmode=disable"

# Read-only connection to WRP property management tables (cloud only).
# Uses the wrp_notebook_app PostgreSQL user (SELECT-only permissions).
# Run scripts/setup-readonly-role.sql in Neon SQL Editor first, then set this.
# Use the direct (non-pooler) Neon hostname for this one.
PROPERTY_DB_URL="postgresql://wrp_notebook_app:CHANGE_ME@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (NextAuth.js v5) ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Required when self-hosting (Docker, etc): Auth.js v5 only auto-trusts the
# request host on Vercel/CF Pages, or when NODE_ENV != production. Without
# this, NODE_ENV=production deployments reject every request as UntrustedHost.
AUTH_TRUST_HOST="true"

# ─── Credential Encryption ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="replace-with-64-char-hex-string"

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Pick ONE of the two blocks below. lib/ai/providers.ts switches on whether
# LLM_BASE_URL is set — leave the local block fully commented out to use cloud.

# --- Option A: cloud (Anthropic + OpenAI) ---
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
# LLM_MODEL="claude-sonnet-4-6"                  # optional override; this is the default
# FAST_LLM_MODEL="claude-haiku-4-5-20251001"     # optional override; this is the default
# EMBEDDING_MODEL="text-embedding-3-small"       # optional override; this is the default

# --- Option B: local LM Studio / llmster (OpenAI-compatible endpoint) ---
# Chat and embeddings both route through the same endpoint locally — there is
# no separate fast-model routing when LLM_BASE_URL is set.
# LLM_BASE_URL="http://llmster:1234"             # host.docker.internal:1234 for the local-dev Compose profile
# ANTHROPIC_API_KEY="lm-studio"                  # unused when LLM_BASE_URL is set, but @ai-sdk/anthropic needs a non-empty value
# LLM_MODEL="gemma-4-2b-it"                      # must match a model already loaded in LM Studio
# EMBEDDING_BASE_URL="http://llmster:1234/v1"
# EMBEDDING_API_KEY="lm-studio"
# EMBEDDING_MODEL="embedding-gemma-300m"         # must match a model already loaded in LM Studio
# EMBEDDING_DIMENSIONS="768"                     # must match the vector(N) column in prisma/schema.prisma

# ─── Rate Limiting (Upstash Redis — optional) ─────────────────────────────────
# If unset, rate limiting on /api/v1/* is simply disabled (no fallback limiter).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── OCR (handwritten/scanned PDF fallback — local_llm_docker only) ───────────
# The `ocr` Compose service is CPU-only and started in every profile. It kicks
# in when a PDF's text layer has fewer than OCR_TEXT_DENSITY_THRESHOLD
# characters per page (including zero — the previous EMPTY_DOCUMENT case).
# Leave OCR_ENABLED unset/false to keep today's EMPTY_DOCUMENT behavior instead.
OCR_ENABLED="true"
OCR_BASE_URL="http://ocr:8000"
OCR_TEXT_DENSITY_THRESHOLD="100"
# OCR_ENGINE (set on the `ocr` service itself, not the notebook container —
# see docker-compose.yml). "stub" (default) needs no model weights; "got-ocr2"
# downloads stepfun-ai/GOT-OCR2_0 on first run — see ocr/README.md.
# OCR_ENGINE="stub"
