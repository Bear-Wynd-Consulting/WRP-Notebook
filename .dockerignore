# Never send secrets or VCS history into the build context.
.git
.env
.env.local
.env.production
.env*.local

# Reinstalled inside the image — sending the host copy just bloats context
# and can leak host-specific native bindings.
node_modules

# Rebuilt inside the image (prisma generate, next build).
/.next/
/app/generated/prisma
*.tsbuildinfo
next-env.d.ts

# testing / misc
/coverage
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
