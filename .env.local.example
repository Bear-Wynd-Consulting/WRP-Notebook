# ─── Database (Neon serverless PostgreSQL) ───────────────────────────────────
# Both vars required: DATABASE_URL uses pooled connection, DIRECT_URL bypasses
# the pool for migrations (Prisma requirement).
# search_path=notebook,public required: notebook tables live in the notebook schema;
# ,public is needed so pgvector types resolve (vector extension is in public schema).
# Pooled connection — do NOT add search_path here; PgBouncer rejects it.
# Prisma multiSchema generates schema-qualified queries so search_path is not needed at runtime.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# Direct connection for migrations — search_path IS supported on the direct endpoint.
DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&options=--search_path%3Dnotebook,public

# ─── Auth (NextAuth.js) ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# ─── Local LLM — Phase 2 (llmster in compose, default) ──────────────────────
# Point both clients at the llmster container.
LLM_BASE_URL=http://llmster:1234
ANTHROPIC_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e2b

EMBEDDING_BASE_URL=http://llmster:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=google/embedding-gemma-300m
EMBEDDING_DIMENSIONS=768

# ─── Local LLM — Phase 1 (llmster on host, notebook-local-dev profile) ───────
# Uncomment these and comment the Phase 2 block above when using
#   docker compose --profile local-dev up
# LLM_BASE_URL=http://host.docker.internal:1234
# ANTHROPIC_API_KEY=lm-studio
# LLM_MODEL=google/gemma-4-e2b
# EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# EMBEDDING_API_KEY=lm-studio
# EMBEDDING_MODEL=google/embedding-gemma-300m
# EMBEDDING_DIMENSIONS=768

# ─── Cloud overrides ─────────────────────────────────────────────────────────
# Remove LLM_BASE_URL / EMBEDDING_BASE_URL entirely to use real cloud APIs.
# Replace the API keys and model names below.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=768

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Optional — API key rate limiting is disabled when these are absent (graceful fallback).
# Required in production to enforce per-key limits on /api/v1/* routes.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ─── Blob storage (Vercel Blob) ───────────────────────────────────────────────
# Only required for URL / text / audio sources.
# PDFs use the in-memory two-phase flow and do NOT need blob storage.
# VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Encryption key ──────────────────────────────────────────────────────────
# AES-256-GCM key for storing AI provider credentials.
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
